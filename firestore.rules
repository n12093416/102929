rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidWorkspaceRecord(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.toolId is string && data.toolId.size() >= 1 && data.toolId.size() <= 64 &&
             data.toolTitle is string && data.toolTitle.size() >= 1 && data.toolTitle.size() <= 100 &&
             data.modelEndpoint is string && data.modelEndpoint.size() >= 1 && data.modelEndpoint.size() <= 150 &&
             data.prompt is string && data.prompt.size() >= 1 && data.prompt.size() <= 20000 &&
             data.responseText is string && data.responseText.size() >= 1 && data.responseText.size() <= 100000 &&
             (!('metadataSummary' in data) || (data.metadataSummary is string && data.metadataSummary.size() <= 200));
    }

    function isValidDirectiveConfig(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.commonDirective is string && data.commonDirective.size() <= 4000 &&
             data.useCommonDirective is bool &&
             data.individualDirectives is map && data.individualDirectives.size() <= 16 &&
             data.individualEnabledMap is map && data.individualEnabledMap.size() <= 16;
    }

    match /users/{userId}/workspaceRecords/{recordId} {
      allow get: if isSignedIn() &&
                    isValidId(userId) &&
                    isValidId(recordId) &&
                    request.auth.uid == userId;

      allow list: if isSignedIn() &&
                     isValidId(userId) &&
                     request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidId(recordId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'userId', 'toolId', 'toolTitle', 'modelEndpoint',
                         'prompt', 'responseText', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'toolId', 'toolTitle', 'modelEndpoint',
                         'prompt', 'responseText', 'metadataSummary',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       isValidWorkspaceRecord(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidId(recordId) &&
                       request.auth.uid == userId &&
                       isValidWorkspaceRecord(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'prompt', 'responseText', 'metadataSummary', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidId(recordId) &&
                       request.auth.uid == userId;
    }

    match /users/{userId}/directiveConfigs/{configId} {
      allow get: if isSignedIn() &&
                    isValidId(userId) &&
                    isValidId(configId) &&
                    request.auth.uid == userId;

      allow list: if isSignedIn() &&
                     isValidId(userId) &&
                     request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidId(configId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'userId', 'commonDirective', 'useCommonDirective',
                         'individualDirectives', 'individualEnabledMap',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'commonDirective', 'useCommonDirective',
                         'individualDirectives', 'individualEnabledMap',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       isValidDirectiveConfig(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidId(configId) &&
                       request.auth.uid == userId &&
                       isValidDirectiveConfig(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'commonDirective', 'useCommonDirective',
                         'individualDirectives', 'individualEnabledMap', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidId(configId) &&
                       request.auth.uid == userId;
    }
  }
}
